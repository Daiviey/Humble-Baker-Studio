<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>hbs-vst-bridge</AssemblyName>
    <RootNamespace>HumbleBakerStudio.VstBridge</RootNamespace>
    <Version>0.1.0</Version>
    <Company>Humble Baker Studio</Company>
    <Product>Humble Baker Studio VST3 bridge</Product>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio.Vst3" Version="3.3.0" />
  </ItemGroup>

</Project>
